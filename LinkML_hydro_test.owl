@prefix dct: <http://purl.org/dc/terms/> .
@prefix envthes: <http://vocabs.lter-europe.net/EnvThes/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix hyobs: <https://w3id.org/hmontology/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hyobs:Geometry a owl:Class ;
    rdfs:label "Geometry" ;
    skos:definition "Spatial geometry associated with a sensor or catchment." ;
    skos:exactMatch geo:Geometry ;
    skos:inScheme hyobs:schema .

hyobs:River a owl:Class ;
    rdfs:label "River" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasRiverBasedRegion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasRiverBasedRegion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:hasRiverBasedRegion ] ;
    skos:exactMatch envthes:20916 ;
    skos:inScheme hyobs:schema .

hyobs:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:producesTimeseries ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:monitorsCatchment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:monitorsCatchment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:producesTimeseries ],
        [ a owl:Restriction ;
            owl:allValuesFrom hyobs:Catchment ;
            owl:onProperty hyobs:monitorsCatchment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:producesTimeseries ] ;
    skos:definition "A gauging station or sensor that monitors a hydrological catchment and may make observations." ;
    skos:exactMatch sosa:Sensor ;
    skos:inScheme hyobs:schema .

hyobs:airTemperatureMeanAnnual a owl:DatatypeProperty ;
    rdfs:label "airTemperatureMeanAnnual" ;
    dct:title "Air Temperature Mean Annual" ;
    rdfs:range xsd:decimal ;
    skos:definition "Hydrological or environmental attribute: air temperature mean annual." ;
    skos:inScheme hyobs:schema .

hyobs:areaRatio a owl:DatatypeProperty ;
    rdfs:label "areaRatio" ;
    dct:title "Area Ratio" ;
    rdfs:range xsd:decimal ;
    skos:definition "Ratio between variable area_calc of basin delineation A and area_gov" ;
    skos:inScheme hyobs:schema .

hyobs:area_ratio a owl:DatatypeProperty ;
