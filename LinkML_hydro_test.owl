hyobs:WaterFractionTopsoil a owl:Class ;
    rdfs:label "WaterFractionTopsoil" ;
    dct:title "Water Fraction Topsoil" ;
    skos:definition "Hydrological observed property or controlled vocabulary concept: water fraction topsoil." ;
    skos:exactMatch hyobs:WaterFractionTopsoil ;
    skos:inScheme hyobs:schema .

hyobs:WindSpeedEast10m a owl:Class ;
    rdfs:label "WindSpeedEast10m" ;
    dct:title "Wind Speed East 10 M" ;
    skos:definition "Eastward component of wind speed at 10 metres above the land surface." ;
    skos:exactMatch hyobs:WindSpeedEast10m ;
    skos:inScheme hyobs:schema .

hyobs:WindSpeedNorth10m a owl:Class ;
    rdfs:label "WindSpeedNorth10m" ;
    dct:title "Wind Speed North 10 M" ;
    skos:definition "Northward component of wind speed at 10 metres above the land surface." ;
    skos:exactMatch hyobs:WindSpeedNorth10m ;
    skos:inScheme hyobs:schema .

hyobs:Analyte a owl:Class ;
    rdfs:label "Analyte" ;
    skos:definition "Chemical or aggregate analyte used in water-quality observations." ;
    skos:exactMatch hyobs:Analyte ;
    skos:inScheme hyobs:schema .

hyobs:Catchment a owl:Class ;
    rdfs:label "Catchment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasRunoffRatio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:flashinessIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasLowPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:minElevation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:flashinessIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:minElevation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:slopeMedian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasRunoffRatio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:maxElevation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasHighPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:maxElevation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasDominantLandUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:aridityIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasAridityIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:maxElevation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasCatchmentArea ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:drainageDensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:medianElevation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasRunoffRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:drainageDensity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:flashinessIndex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:has_mvert_ang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:baseflowIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasAridityIndex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:slopeMean ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:drainageDensity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasSnowFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:slopeMean ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasLowPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasSnowFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasMeanEvapotranspiration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasHighPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasMeanDailyPrecip ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasSnowFraction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:aridityIndex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:meanElevation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:hasDominantLandUse ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:meanSlope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasMeanDailyPrecip ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:baseflowIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasDominantLandUse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:slopeMedian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:slopeMedian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:precipSeasonalityIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:slopeMean ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:medianElevation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:hasCatchmentArea ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:precipitationSeasonality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasCatchmentArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:hasLowPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasMeanEvapotranspiration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:meanElevation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:precipitationSeasonality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasRiverBasedRegion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasRiverBasedRegion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:precipSeasonalityIndex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:minElevation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasAridityIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:aridityIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:has_mvert_ang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:baseflowIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:hasHighPrecipitationSeason ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:medianElevation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:precipSeasonalityIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty hyobs:has_mvert_ang ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:precipitationSeasonality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:hasRiverBasedRegion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:has_mvert_dist ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:meanSlope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:hasMeanDailyPrecip ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:meanSlope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hyobs:has_mvert_dist ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:has_mvert_dist ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hyobs:hasMeanEvapotranspiration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hyobs:meanElevation ] ;
    skos:definition "A hydrological catchment or drainage basin represented as a feature of interest for sensors and observations." ;
    skos:exactMatch envthes:30212 ;
    skos:inScheme hyobs:schema .

hyobs:GovnrID a owl:Class ;
    rdfs:label "GovnrID" ;
    skos:definition "Government ID" ;
    skos:exactMatch hyobs:GovnrID ;
    skos:inScheme hyobs:schema .

hyobs:Procedure a owl:Class ;
    rdfs:label "Procedure" ;
    skos:definition "Procedure or method used to create or normalize observations." ;
    skos:exactMatch hyobs:Procedure ;
    skos:inScheme hyobs:schema .

hyobs:aridityIndex a owl:DatatypeProperty ;
    rdfs:label "aridityIndex" ;
    dct:title "Aridity Index" ;
    rdfs:range xsd:decimal ;
    skos:definition "Aridity index of a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:baseflowIndex a owl:DatatypeProperty ;
    rdfs:label "baseflowIndex" ;
    dct:title "Baseflow Index" ;
    rdfs:range xsd:decimal ;
    skos:definition "Baseflow index describing the fraction of streamflow sustained by baseflow." ;
    skos:inScheme hyobs:schema .

hyobs:drainageDensity a owl:DatatypeProperty ;
    rdfs:label "drainageDensity" ;
    dct:title "Drainage Density" ;
    rdfs:range xsd:decimal ;
    skos:definition "Drainage density of a catchment, usually calculated as stream length per unit catchment area." ;
    skos:inScheme hyobs:schema .

hyobs:flashinessIndex a owl:DatatypeProperty ;
    rdfs:label "flashinessIndex" ;
    dct:title "Flashiness Index" ;
    rdfs:range xsd:decimal ;
    skos:definition "Hydrological flashiness index describing short-term variability of streamflow." ;
    skos:inScheme hyobs:schema .

hyobs:hasAridityIndex a owl:DatatypeProperty ;
    rdfs:label "hasAridityIndex" ;
    dct:title "Aridity Index" ;
    rdfs:range xsd:decimal ;
    skos:definition "Aridity index of a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:hasCatchmentArea a owl:DatatypeProperty ;
    rdfs:label "hasCatchmentArea" ;
    dct:title "Has Catchment Area" ;
    rdfs:range xsd:decimal ;
    skos:definition "Area of a catchment, represented either as a decimal value or as a QUDT quantity value with an explicit area unit." ;
    skos:inScheme hyobs:schema .

hyobs:hasDominantLandUse a owl:DatatypeProperty ;
    rdfs:label "hasDominantLandUse" ;
    dct:title "Dominant land use type" ;
    rdfs:range xsd:string ;
    skos:definition "Hydrological or environmental attribute: has dominant land use." ;
    skos:inScheme hyobs:schema .

hyobs:hasHighPrecipitationSeason a owl:DatatypeProperty ;
    rdfs:label "hasHighPrecipitationSeason" ;
    dct:title "has High precipitation season" ;
    rdfs:range xsd:string ;
    skos:definition "Hydrological or environmental attribute: has high precipitation season." ;
    skos:inScheme hyobs:schema .

hyobs:hasLowPrecipitationSeason a owl:DatatypeProperty ;
    rdfs:label "hasLowPrecipitationSeason" ;
    dct:title "has Low precipitation season" ;
    rdfs:range xsd:string ;
    skos:definition "Hydrological or environmental attribute: has low precipitation season." ;
    skos:inScheme hyobs:schema .

hyobs:hasMeanDailyPrecip a owl:DatatypeProperty ;
    rdfs:label "hasMeanDailyPrecip" ;
    dct:title "Mean Daily Precipitation" ;
    rdfs:range xsd:decimal ;
    skos:definition "Long-term mean daily precipitation for a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:hasMeanEvapotranspiration a owl:DatatypeProperty ;
    rdfs:label "hasMeanEvapotranspiration" ;
    dct:title "Mean Daily Evapotranspiration" ;
    rdfs:range xsd:decimal ;
    skos:definition "Long-term mean daily evapotranspiration for a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:hasRunoffRatio a owl:DatatypeProperty ;
    rdfs:label "hasRunoffRatio" ;
    dct:title "Has Runoff Ratio" ;
    rdfs:range xsd:decimal ;
    skos:definition "Ratio of runoff to precipitation for a catchment." ;
    skos:inScheme hyobs:schema .

hyobs:hasSnowFraction a owl:DatatypeProperty ;
    rdfs:label "hasSnowFraction" ;
    dct:title "Snow Fraction" ;
    rdfs:range xsd:decimal ;
    skos:definition "Fraction of precipitation that falls as snow." ;
    skos:inScheme hyobs:schema .

hyobs:has_mvert_ang a owl:DatatypeProperty ;
    rdfs:label "has_mvert_ang" ;
    dct:title "Has mvert ang" ;
    rdfs:range xsd:decimal ;
    skos:definition "Hydrological or environmental attribute: has mvert ang." ;
    skos:inScheme hyobs:schema .

hyobs:has_mvert_dist a owl:DatatypeProperty ;
    rdfs:label "has_mvert_dist" ;
    dct:title "Longest distance from the gauge" ;
    rdfs:range xsd:string ;
    skos:definition "Hydrological or environmental attribute: has mvert dist." ;
    skos:inScheme hyobs:schema .

hyobs:maxElevation a owl:DatatypeProperty ;
    rdfs:label "maxElevation" ;
    dct:title "Maximum Elevation" ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum elevation of a catchment or spatial unit, normally expressed as a QUDT quantity value in metres." ;
    skos:inScheme hyobs:schema .

hyobs:meanElevation a owl:DatatypeProperty ;
    rdfs:label "meanElevation" ;
    dct:title "Mean Elevation" ;
    rdfs:range xsd:decimal ;
    skos:definition "Mean elevation of a catchment or spatial unit, normally expressed as a QUDT quantity value in metres." ;
    skos:inScheme hyobs:schema .

hyobs:meanSlope a owl:DatatypeProperty ;
    rdfs:label "meanSlope" ;
    dct:title "Mean Slope" ;
    rdfs:range xsd:decimal ;
    skos:definition "Mean terrain slope of a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:medianElevation a owl:DatatypeProperty ;
    rdfs:label "medianElevation" ;
    dct:title "Median Elevation" ;
    rdfs:range xsd:decimal ;
    skos:definition "Median elevation of a catchment or spatial unit, normally expressed as a QUDT quantity value in metres." ;
    skos:inScheme hyobs:schema .

hyobs:minElevation a owl:DatatypeProperty ;
    rdfs:label "minElevation" ;
    dct:title "Minimum Elevation" ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum elevation of a catchment or spatial unit, normally expressed as a QUDT quantity value in metres." ;
    skos:inScheme hyobs:schema .

hyobs:monitorsCatchment a owl:ObjectProperty ;
    rdfs:label "monitorsCatchment" ;
    dct:title "monitors Catchment" ;
    rdfs:range hyobs:Catchment ;
    skos:definition "Relates a hydrological monitoring sensor or gauging station to the catchment it monitors." ;
    skos:inScheme hyobs:schema .

hyobs:precipSeasonalityIndex a owl:DatatypeProperty ;
    rdfs:label "precipSeasonalityIndex" ;
    dct:title "Precip Seasonality Index" ;
    rdfs:range xsd:decimal ;
    skos:definition "Seasonality index describing the timing and distribution of precipitation through the year." ;
    skos:inScheme hyobs:schema .

hyobs:precipitationSeasonality a owl:DatatypeProperty ;
    rdfs:label "precipitationSeasonality" ;
    dct:title "Precipitation Seasonality" ;
    rdfs:range xsd:decimal ;
    skos:definition "Seasonality index describing the timing and distribution of precipitation through the year." ;
    skos:inScheme hyobs:schema .

hyobs:producesTimeseries a owl:DatatypeProperty ;
    rdfs:label "producesTimeseries" ;
    dct:title "has Time Series" ;
    rdfs:range xsd:string ;
    skos:definition "has Time Series" ;
    skos:inScheme hyobs:schema .

hyobs:slopeMean a owl:DatatypeProperty ;
    rdfs:label "slopeMean" ;
    dct:title "Slope Mean" ;
    rdfs:range xsd:decimal ;
    skos:definition "Mean terrain slope of a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:slopeMedian a owl:DatatypeProperty ;
    rdfs:label "slopeMedian" ;
    dct:title "Slope Median" ;
    rdfs:range xsd:decimal ;
    skos:definition "Median terrain slope of a catchment or spatial unit." ;
    skos:inScheme hyobs:schema .

hyobs:AirTemperature2m a owl:Class ;
    rdfs:label "AirTemperature2m" ;
    skos:definition "Air temperature at a height of 2 m above Earth surface" ;
    skos:exactMatch hyobs:AirTemperature2m ;
    skos:inScheme hyobs:schema .

hyobs:DewPointTemperature2m a owl:Class ;
    rdfs:label "DewPointTemperature2m" ;
    skos:definition "Dew point temperature at a height of 2 m above Earth surface" ;
    skos:exactMatch hyobs:DewPointTemperature2m ;
    skos:inScheme hyobs:schema .

hyobs:SurfaceNetSolarRadiation a owl:Class ;
    rdfs:label "SurfaceNetSolarRadiation" ;
    skos:definition "Class representing observations of surface net solar radiation, i.e., the amount of solar radiation reaching the Earth's surface minus the amount reflected by the Earth's surface (governed by albedo); positive sign is an indicator for radiation to the Earth" ;
    skos:exactMatch hyobs:SurfaceNetSolarRadiation ;
    skos:inScheme hyobs:schema .

hyobs:SurfaceNetThermalRadiation a owl:Class ;
    rdfs:label "SurfaceNetThermalRadiation" ;
    skos:definition "Class representing observations of surface thermal radiation, i.e., net thermal radiation at the Earth's surface; positive sign is an indicator for radiation from the Earth." ;
    skos:exactMatch hyobs:SurfaceNetThermalRadiation ;
    skos:inScheme hyobs:schema .

hyobs:hasRiverBasedRegion a owl:DatatypeProperty ;
    rdfs:label "hasRiverBasedRegion" ;
    dct:title "River-based region" ;
    rdfs:range xsd:string ;
    skos:definition "Name or identifier of the river-based region associated with a gauging station or catchment." ;
    skos:inScheme hyobs:schema .

hyobs:WaterQualityProperty a owl:Class ;
    rdfs:label "WaterQualityProperty" ;
    skos:definition "Observed water-quality property represented in QUADICA observations." ;
    skos:exactMatch hyobs:WaterQualityProperty ;
    skos:inScheme hyobs:schema .